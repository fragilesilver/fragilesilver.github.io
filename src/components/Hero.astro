---
---

<section class="relative pt-16 pb-20 md:pt-24 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center max-w-4xl mx-auto">
      
      <!-- Personal developer badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium bg-blue-500/10 border border-blue-500/30 text-blue-300 mb-8 backdrop-blur-sm shadow-sm hover:border-purple-500/50 transition-colors">
        <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
        <span class="font-mono">fragilesilver • Software Developer Portfolio</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white mb-6 leading-[1.12]">
        Crafting retro handheld tools, <br />
        <span class="text-gradient">interactive games & code.</span>
      </h1>

      <!-- Bio / Tagline -->
      <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mb-10 leading-relaxed">
        I design lightweight, purposeful utilities for retro gaming handhelds (<strong class="text-white">muOS on Anbernic RG35XX</strong>) and real-time multiplayer educational web applications. Built with craft, performance, and tactile joy.
      </p>

      <!-- Action buttons -->
      <div class="flex flex-wrap items-center justify-center gap-4 w-full sm:w-auto">
        <a
          href="#works"
          class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 hover:from-blue-500 hover:via-indigo-500 hover:to-purple-500 shadow-lg shadow-blue-500/25 transition-all duration-200 hover:scale-[1.02] flex items-center justify-center gap-2"
        >
          <span>Explore Works</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>

        <a
          href="/apps"
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-semibold text-slate-200 bg-slate-900/80 hover:bg-slate-800 border border-slate-700 hover:border-slate-600 transition-all flex items-center justify-center gap-2"
        >
          <span>muOS Handheld Suite</span>
          <span class="text-xs font-mono px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-300">5 apps</span>
        </a>

        <a
          href="https://github.com/fragilesilver"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-5 py-3.5 rounded-xl font-medium text-slate-300 hover:text-white bg-slate-900/40 hover:bg-slate-800/60 border border-slate-800 transition-colors flex items-center justify-center gap-2 text-sm"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub</span>
        </a>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 pt-10 border-t border-slate-800/80 w-full text-center">
        <div class="p-3">
          <div class="text-2xl sm:text-3xl font-bold font-mono text-blue-400">Handheld Apps</div>
          <div class="text-xs text-slate-400 mt-1">ClockMu, JarMu, BatteryMu +</div>
        </div>
        <div class="p-3">
          <div class="text-2xl sm:text-3xl font-bold font-mono text-purple-400">Classroom Web</div>
          <div class="text-xs text-slate-400 mt-1">CHMS Battleship Royale</div>
        </div>
        <div class="p-3">
          <div class="text-2xl sm:text-3xl font-bold font-mono text-cyan-400">fskit Framework</div>
          <div class="text-xs text-slate-400 mt-1">Shared LÖVE2D Toolkit</div>
        </div>
        <div class="p-3">
          <div class="text-2xl sm:text-3xl font-bold font-mono text-emerald-400">Open Source</div>
          <div class="text-xs text-slate-400 mt-1">Available on GitHub</div>
        </div>
      </div>

    </div>
  </div>
</section>
