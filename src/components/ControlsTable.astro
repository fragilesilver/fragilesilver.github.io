---
import ControlsBadge from './ControlsBadge.astro';

interface ControlItem {
  button: string;
  action: string;
}

interface Props {
  title?: string;
  controls: ControlItem[];
}

const { title, controls } = Astro.props;
---

<div class="glass-panel rounded-2xl p-5 border border-slate-800 my-6">
  {title && (
    <h3 class="text-sm font-semibold text-white tracking-wide uppercase font-mono mb-4 flex items-center gap-2">
      <span class="w-2 h-2 rounded-sm bg-blue-500"></span>
      {title}
    </h3>
  )}
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm text-slate-300">
      <thead class="text-xs uppercase text-slate-400 border-b border-slate-800">
        <tr>
          <th scope="col" class="py-2.5 px-4 font-mono font-medium">Button</th>
          <th scope="col" class="py-2.5 px-4 font-medium">Function / Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 font-mono text-xs">
        {controls.map((item) => (
          <tr class="hover:bg-slate-800/30 transition-colors">
            <td class="py-2.5 px-4 whitespace-nowrap font-medium text-white">
              <ControlsBadge button={item.button} />
            </td>
            <td class="py-2.5 px-4 text-slate-300 font-sans text-sm">
              {item.action}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
