---
const principles = [
  {
    title: "Lightweight & Bloat-Free",
    desc: "Crafting software that boots in milliseconds, conserves battery, and minimizes memory consumption across handheld and web platforms.",
  },
  {
    title: "Tactile & Joyful Ergonomics",
    desc: "Prioritizing physical gamepad button contracts, clean layout letterboxing, and rewarding audio/visual interactions.",
  },
  {
    title: "Independent & Self-Contained",
    desc: "Delivering standalone archives and robust data persistence that survives firmware updates and operating system reboots.",
  },
  {
    title: "Pedagogy & Open Collaboration",
    desc: "Creating tools that demystify computer science concepts and sharing open code for retro gaming and educational communities.",
  },
];

const technologies = [
  "Lua",
  "LÖVE2D",
  "fskit",
  "TypeScript",
  "JavaScript",
  "Astro",
  "Tailwind CSS",
  "Firebase Realtime DB",
  "Allwinner H700",
  "muOS Andromeda",
  "Linux sysfs",
  "Bash",
  "Git & GitHub Actions",
];
---

<section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-slate-800 relative overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      <!-- Left: Principles -->
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-purple-500/10 text-purple-400 border border-purple-500/30 mb-4">
          <span>Craftsmanship</span>
        </div>
        <h2 class="text-3xl font-extrabold text-white tracking-tight mb-4">
          Development <span class="text-gradient">Philosophy</span>
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed mb-8">
          Whether designing an alarm clock for a pocket Linux console or a live multiplayer ocean arena for students, I believe software should be intentional, fast, and delightful to interact with.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {principles.map((p) => (
            <div class="p-4 rounded-xl bg-slate-900/70 border border-slate-800">
              <h3 class="font-bold text-sm text-white mb-1.5">{p.title}</h3>
              <p class="text-slate-400 text-xs leading-relaxed">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Tech Stack Pills -->
      <div class="bg-slate-950/80 rounded-2xl p-7 border border-slate-800/80">
        <h3 class="font-bold text-base text-white mb-2 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          Core Toolkit & Technologies
        </h3>
        <p class="text-slate-400 text-xs mb-6">
          Technologies and environments I work with daily:
        </p>

        <div class="flex flex-wrap gap-2">
          {technologies.map((tech) => (
            <span class="px-3 py-1.5 rounded-lg text-xs font-mono bg-slate-900 border border-slate-700/80 text-slate-200 hover:border-blue-500/50 hover:text-white transition-colors">
              {tech}
            </span>
          ))}
        </div>

        <div class="mt-8 pt-6 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
          <span>Target Hardware: RG35XX Pro, Plus, H, SP, 2024</span>
          <span class="text-blue-400 font-mono font-medium">H700 Mali-G31</span>
        </div>
      </div>

    </div>
  </div>
</section>
