---
const disciplines = [
  {
    title: "Handheld & Embedded Systems",
    icon: `<svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2zM9 9h6m-6 4h6"></path></svg>`,
    tag: "Lua • LÖVE2D • muOS",
    description: "Architecting native software for Linux-based retro consoles (Allwinner H700 / Anbernic RG35XX). Master of letterboxed integer rendering, hardware sysfs PMIC readouts, and physical button UX.",
    accent: "blue",
  },
  {
    title: "Interactive & Multiplayer Web",
    icon: `<svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>`,
    tag: "TypeScript • Firebase • Realtime",
    description: "Developing synchronized, zero-barrier classroom multiplayer games. Creating rich teacher orchestrator dashboards, projector arenas, and Cambridge IGCSE pseudocode challenge engines.",
    accent: "purple",
  },
  {
    title: "Frameworks & Developer Toolkits",
    icon: `<svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>`,
    tag: "fskit • Tooling • Automation",
    description: "Engineering shared toolkits like fskit for multi-resolution rendering, gamepad input contracts, theme engines, and robust data persistence independent of save-dir bindings.",
    accent: "cyan",
  },
];
---

<section class="py-12 md:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex flex-col items-center text-center mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-blue-500/10 text-blue-400 border border-blue-500/30 mb-3">
      <span>Areas of Expertise</span>
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-3">
      What I Build & Explore
    </h2>
    <p class="text-slate-400 text-sm sm:text-base max-w-xl">
      Blending low-level handheld firmware development with real-time web mechanics.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {disciplines.map((item) => (
      <div class="glass-panel rounded-2xl p-7 border border-slate-800/80 hover:border-slate-700 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-slate-900 border border-slate-800 p-2.5 flex items-center justify-center mb-5 shadow-inner">
            <Fragment set:html={item.icon} />
          </div>
          <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-slate-800/80 text-slate-300 border border-slate-700/60 inline-block mb-3">
            {item.tag}
          </span>
          <h3 class="text-xl font-bold text-white mb-2.5">
            {item.title}
          </h3>
          <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-6">
            {item.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
