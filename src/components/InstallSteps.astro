---
const steps = [
  {
    step: "01",
    title: "Download .muxapp",
    desc: "Grab the latest .muxapp release package from GitHub Releases for your chosen app.",
    icon: "download",
  },
  {
    step: "02",
    title: "Transfer to SD Card",
    desc: "Copy the .muxapp file to the ARCHIVE/ directory on your SD1 or SD2 card.",
    icon: "sd-card",
  },
  {
    step: "03",
    title: "Open Archive Manager",
    desc: "On your handheld device, go to Applications → Archive Manager and select the file.",
    icon: "archive",
  },
  {
    step: "04",
    title: "Launch & Enjoy",
    desc: "Launch your newly installed app directly from Applications in muOS.",
    icon: "play",
  },
];
---

<div class="glass-panel rounded-3xl p-8 sm:p-10 border border-slate-800">
  <div class="max-w-2xl mb-10">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-blue-500/10 text-blue-400 border border-blue-500/30 mb-3">
      <span>muOS Andromeda Package Setup</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-2">
      How to install on your device
    </h2>
    <p class="text-slate-400 text-sm">
      All muOS apps are packaged as standalone <code class="font-mono text-blue-300">.muxapp</code> archives bundling their own LÖVE runtime and dependencies.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 relative">
    {steps.map((item) => (
      <div class="relative bg-slate-900/60 rounded-2xl p-6 border border-slate-800/80 hover:border-slate-700 transition-colors flex flex-col justify-between">
        <div>
          <div class="text-2xl font-mono font-extrabold text-gradient mb-4">
            {item.step}
          </div>
          <h3 class="font-bold text-base text-white mb-2">
            {item.title}
          </h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            {item.desc}
          </p>
        </div>
      </div>
    ))}
  </div>

  <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2 text-xs text-slate-400">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>No terminal commands or root access required on device</span>
    </div>
    <a
      href="/guide/install"
      class="text-xs font-semibold text-blue-400 hover:text-purple-300 transition-colors flex items-center gap-1"
    >
      <span>Read complete installation guide</span>
      <span class="text-sm">→</span>
    </a>
  </div>
</div>
