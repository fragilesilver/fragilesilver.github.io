---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-800/80 bg-[#07090e] text-slate-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Brand column -->
      <div class="space-y-4 md:col-span-1">
        <div class="flex items-center gap-2.5">
          <img src="/assets/icons/fragilesilver-logo.svg" alt="fragilesilver" class="w-7 h-7" />
          <span class="font-bold text-white text-base">fragile<span class="text-gradient">silver</span></span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          Crafting thoughtful handheld tools, retro gaming utilities, and educational multiplayer games with precision and care.
        </p>
        <div class="flex items-center gap-3 pt-1">
          <a
            href="https://github.com/fragilesilver"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-400 hover:text-white transition-colors"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- muOS Apps -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200">muOS Apps</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/apps/clockmu" class="hover:text-blue-400 transition-colors">ClockMu (Alarm Clock)</a></li>
          <li><a href="/apps/jarmu" class="hover:text-purple-400 transition-colors">JarMu (Game Picker)</a></li>
          <li><a href="/apps/batterymu" class="hover:text-blue-400 transition-colors">BatteryMu (Battery Monitor)</a></li>
          <li><a href="/apps/swapmu" class="hover:text-purple-400 transition-colors">SwapMu (SRAM Swapper)</a></li>
          <li><a href="/apps/scrapmu" class="hover:text-blue-400 transition-colors">ScrapMu (Box Art Scraper)</a></li>
        </ul>
      </div>

      <!-- Other Projects -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200">Web & Games</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/projects/chms-battleship" class="hover:text-blue-400 transition-colors">CHMS Battleship Royale</a></li>
          <li><a href="/projects" class="hover:text-purple-400 transition-colors">All Projects Directory</a></li>
          <li><a href="https://github.com/fragilesilver" target="_blank" rel="noopener noreferrer" class="hover:text-slate-200 transition-colors">GitHub Repositories ↗</a></li>
        </ul>
      </div>

      <!-- Resources & Handhelds -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200">Ecosystem</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/guide/install" class="hover:text-blue-400 transition-colors">.muxapp Installation Guide</a></li>
          <li><a href="https://muos.dev" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors">muOS Official Website ↗</a></li>
          <li><span class="text-slate-500">Target: Anbernic RG35XX Family (H700)</span></li>
          <li><span class="text-slate-500">Framework: LÖVE2D + fskit</span></li>
        </ul>
      </div>

    </div>

    <!-- Bottom subfooter -->
    <div class="mt-12 pt-6 border-t border-slate-800/60 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© {currentYear} fragilesilver. Open-source under MIT and GPL-3.0 licenses.</p>
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-blue-500"></span>
        <span>Built with Astro & Tailwind CSS</span>
      </div>
    </div>
  </div>
</footer>
