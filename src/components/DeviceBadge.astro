---
interface Props {
  device?: string;
  chipset?: string;
}

const {
  device = "Anbernic RG35XX Family",
  chipset = "Allwinner H700"
} = Astro.props;
---

<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-slate-900/90 border border-slate-700/80 text-slate-300">
  <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
  <span class="font-semibold text-white">{device}</span>
  <span class="text-slate-500">•</span>
  <span class="text-purple-300">{chipset}</span>
</div>
