---
interface Props {
  button: string;
}

const { button } = Astro.props;

const normalized = button.trim().toUpperCase();

function getBtnClass(btn: string) {
  if (btn === 'A') return 'gamepad-btn gamepad-btn-a';
  if (btn === 'B') return 'gamepad-btn gamepad-btn-b';
  if (btn === 'X') return 'gamepad-btn gamepad-btn-x';
  if (btn === 'Y') return 'gamepad-btn gamepad-btn-y';
  if (btn.includes('L1') || btn.includes('R1') || btn.includes('L2') || btn.includes('R2')) {
    return 'gamepad-btn gamepad-btn-shoulder';
  }
  return 'gamepad-btn';
}
---

<span class={getBtnClass(normalized)}>{button}</span>
