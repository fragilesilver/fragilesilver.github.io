---
import Layout from '../../layouts/Layout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
---

<Layout
  title="Projects Directory • fragilesilver"
  description="All open-source projects, handheld utilities, games, and experimental web tools by fragilesilver."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-purple-500/10 text-purple-400 border border-purple-500/30 mb-4">
        <span>Software & Experiments</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        All <span class="text-gradient">Projects</span>
      </h1>
      <p class="text-slate-300 text-base leading-relaxed">
        Browse the complete roster of software, from muOS custom firmware companion apps to multiplayer educational games and developer kits.
      </p>
    </div>

    <ProjectGrid showFilters={true} />
  </div>
</Layout>
