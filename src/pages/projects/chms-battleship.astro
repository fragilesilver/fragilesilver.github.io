---
import Layout from '../../layouts/Layout.astro';

const roles = [
  { role: 'Captain', duty: 'Places the team fleet and assigns specialist jobs to the crew.' },
  { role: 'Gunner', duty: 'The primary sharpshooter authorized to fire torpedoes and artillery.' },
  { role: 'Navigator', duty: 'Solves pseudocode logic to unlock radar and sonar scans.' },
  { role: 'Scientist', duty: 'Completes algorithms to recharge tactical airstrikes and countermeasures.' },
  { role: 'Crew', duty: 'Earns communal shots and recommends coordinate targets to the gunner.' },
];
---

<Layout
  title="CHMS Battleship Royale • Classroom Multiplayer Game"
  description="Classroom multiplayer battle-royale Battleship game powered by Cambridge IGCSE pseudocode questions, Firebase Realtime DB, and projector mode."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    
    <!-- Hero Header -->
    <div class="glass-panel rounded-3xl p-8 sm:p-10 border border-slate-800 mb-12 relative overflow-hidden">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="flex items-center gap-5">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-slate-900 border border-slate-700 p-2.5 flex items-center justify-center shadow-lg shadow-purple-500/10">
            <img src="/assets/icons/chms-battleship.svg" alt="CHMS Battleship Logo" class="max-w-full max-h-full object-contain" />
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <h1 class="text-2xl sm:text-3xl font-bold text-white">CHMS Battleship Royale</h1>
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/30">v1.0.0</span>
            </div>
            <p class="text-slate-400 text-sm">
              Classroom battle-royale Battleship with Cambridge IGCSE pseudocode
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="https://github.com/fragilesilver/chms-battleship"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-xl font-semibold text-xs text-white bg-purple-600 hover:bg-purple-500 transition-colors flex items-center gap-2 shadow-md shadow-purple-600/20"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>GitHub Repository</span>
          </a>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-wrap items-center gap-3">
        <span class="text-xs font-mono text-purple-300 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/30">Cambridge IGCSE 0478 / 2210</span>
        <span class="text-xs font-mono text-blue-300 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30">Firebase Realtime DB</span>
        <span class="text-xs font-mono text-slate-400 px-3 py-1 rounded-full bg-slate-900 border border-slate-800">No Account Required</span>
      </div>
    </div>

    <!-- Overview & Game Mechanics -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
        How the Battle Royale Works
      </h2>
      <p class="text-slate-300 text-sm leading-relaxed mb-6">
        Student crews share one massive communal ocean on the classroom projector. To fire shots and sink opponent fleets, students must solve real Cambridge IGCSE and O Level pseudocode questions covering trace tables, conditional logic, loops, and array manipulations.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <div class="text-xs font-mono text-blue-400 mb-1">01. For Students</div>
          <h3 class="text-white font-semibold text-sm mb-2">Instant Phone / Laptop Join</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Students scan a QR code from the projector, enter their callsign, pick a team, and play without needing logins or passwords.
          </p>
        </div>

        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <div class="text-xs font-mono text-purple-400 mb-1">02. For Teachers</div>
          <h3 class="text-white font-semibold text-sm mb-2">Live Teacher Dashboard</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Full orchestrator controls: configure team counts, fleet sizes, starting shots, storm radius intervals, and grant bonus shots.
          </p>
        </div>

        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <div class="text-xs font-mono text-cyan-400 mb-1">03. For Classroom</div>
          <h3 class="text-white font-semibold text-sm mb-2">Projector Arena View</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Live spectator board projecting the shared ocean grid, active radar sweeps, incoming hits, sunken ships, and closing storm walls.
          </p>
        </div>
      </div>
    </div>

    <!-- Crew Roles -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
        Specialist Crew Roles
      </h2>
      <div class="glass-panel rounded-2xl p-5 border border-slate-800">
        <div class="divide-y divide-slate-800/80 text-xs">
          {roles.map((r) => (
            <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4">
              <div class="font-mono font-bold text-blue-300 w-32">{r.role}</div>
              <div class="text-slate-300 flex-1">{r.duty}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Pseudocode bank sample -->
    <div class="glass-panel rounded-2xl p-6 border border-slate-800 font-mono text-xs text-slate-300 space-y-3">
      <h3 class="font-bold text-sm text-white font-sans">Cambridge-Style Question Bank</h3>
      <p class="font-sans text-slate-400 text-xs">
        Questions evaluate fundamental computer science understanding directly aligned with syllabus guidelines:
      </p>
      <pre class="bg-slate-950 p-4 rounded-xl border border-slate-800 text-purple-300 overflow-x-auto">
DECLARE Total : INTEGER
Total &lt;- 0
FOR Count &lt;- 1 TO 5
    IF Count MOD 2 = 0 THEN
        Total &lt;- Total + Count
    ENDIF
NEXT Count
OUTPUT Total
-- What is the final value of Total? (Answer unlocks 2 artillery shots)</pre>
    </div>

  </div>
</Layout>
