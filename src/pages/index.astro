---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Disciplines from '../components/Disciplines.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Philosophy from '../components/Philosophy.astro';
---

<Layout
  title="fragilesilver • Developer Portfolio"
  description="Personal developer portfolio of fragilesilver, showcasing retro handheld software (ClockMu, JarMu, BatteryMu, SwapMu, ScrapMu), fskit, and CHMS Battleship Royale."
>
  <!-- Personal Developer Hero -->
  <Hero />

  <!-- Core Specialty Pillars -->
  <Disciplines />

  <!-- Selected Works & Projects Showcase -->
  <section id="works" class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-purple-500/10 text-purple-400 border border-purple-500/30 mb-3">
        <span>Selected Portfolio</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-3">
        Featured Works & Projects
      </h2>
      <p class="text-slate-400 text-sm sm:text-base max-w-xl">
        Explore software across handheld gaming, web multiplayer, and developer toolkits.
      </p>
    </div>

    <!-- Category Filter & Grid -->
    <ProjectGrid showFilters={true} />
  </section>

  <!-- muOS Handheld Suite Portal Banner -->
  <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass-panel rounded-3xl p-8 sm:p-10 border border-slate-800 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-amber-500/10 text-amber-400 border border-amber-500/30 mb-3">
          <span>Dedicated muOS Andromeda Ecosystem</span>
        </div>
        <h3 class="text-2xl font-bold text-white mb-2">
          Looking for the muOS Handheld Apps Suite?
        </h3>
        <p class="text-slate-300 text-sm leading-relaxed">
          Visit the dedicated muOS Hub for full technical documentation on ClockMu, JarMu, BatteryMu, SwapMu, and ScrapMu, including gamepad controls, hardware compatibility, and the .muxapp installation guide.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a
          href="/apps"
          class="px-6 py-3 rounded-xl font-semibold text-xs text-white bg-blue-600 hover:bg-blue-500 transition-colors shadow-md shadow-blue-500/20"
        >
          Explore Handheld Hub →
        </a>
        <a
          href="/guide/install"
          class="px-5 py-3 rounded-xl font-medium text-xs text-slate-300 bg-slate-900 hover:bg-slate-800 border border-slate-700 transition-colors"
        >
          Install Guide
        </a>
      </div>
    </div>
  </section>

  <!-- Craftsmanship & Philosophy -->
  <Philosophy />
</Layout>
