---
import Layout from '../../layouts/Layout.astro';
import DeviceBadge from '../../components/DeviceBadge.astro';

const steps = [
  {
    num: "1",
    title: "Download the .muxapp Release Package",
    desc: "Navigate to the Releases page of your desired app on GitHub and download the latest compiled .muxapp archive file (e.g. ClockMu-1.0.0.muxapp, SwapMu-1.0.0.muxapp).",
  },
  {
    num: "2",
    title: "Transfer to your SD Card's ARCHIVE/ Folder",
    desc: "Connect your SD card (either SD1 or SD2) to your computer using a card reader, USB transfer, or over Wi-Fi/SFTP. Place the downloaded .muxapp file directly into the ARCHIVE/ directory located at the root of your SD card.",
  },
  {
    num: "3",
    title: "Open Archive Manager on Your Handheld",
    desc: "Boot your handheld device into muOS Andromeda. On the main muOS home menu, navigate to Applications, then scroll down and open Archive Manager.",
  },
  {
    num: "4",
    title: "Extract and Install the App",
    desc: "In Archive Manager, select the .muxapp file from the list and press [A]. muOS will automatically unpack the application binaries, icons, and launcher scripts into their proper system directories.",
  },
  {
    num: "5",
    title: "Launch from Applications Menu",
    desc: "Return to the muOS Applications menu. Your newly installed application will now be visible with its custom icon. Press [A] to launch and enjoy!",
  },
];

const faqs = [
  {
    q: "Will updating an app erase my alarms, game filters, or battery history?",
    a: "No! All fragilesilver apps use persistent storage directories (e.g., save/ via exported environment variables like $CLOCKMU_DATA or $JARMU_DATA). Your settings and history survive updates and reboots.",
  },
  {
    q: "Do I need SSH, a terminal, or custom scripts to install these?",
    a: "Not at all. The .muxapp format is native to muOS and is handled entirely through the built-in muOS Archive Manager interface.",
  },
  {
    q: "Which handheld devices are supported?",
    a: "All Allwinner H700 devices running muOS Andromeda: Anbernic RG35XX Pro, RG35XX Plus, RG35XX H, RG35XX SP, and the RG35XX (2024 revision).",
  },
  {
    q: "Can I remove the .muxapp file after installing?",
    a: "Yes. Once the Archive Manager has successfully installed the application, you can safely delete the original .muxapp file from your ARCHIVE/ folder to save storage.",
  },
];
---

<Layout
  title="muOS .muxapp Installation Guide • fragilesilver"
  description="Step-by-step instructions for installing .muxapp archives on muOS Andromeda using the built-in Archive Manager."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    
    <!-- Header -->
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-blue-500/10 text-blue-400 border border-blue-500/30 mb-4">
        <span>Handheld Setup Guide</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        How to Install <span class="text-gradient">.muxapp</span> Packages
      </h1>
      <p class="text-slate-300 text-base leading-relaxed mb-6">
        A quick, beginner-friendly walkthrough on installing ClockMu, JarMu, BatteryMu, SwapMu, and ScrapMu on your Anbernic handheld running muOS Andromeda.
      </p>
      <div>
        <DeviceBadge device="muOS Andromeda 2606.0+" chipset="Allwinner H700" />
      </div>
    </div>

    <!-- Step by Step -->
    <div class="space-y-6 mb-16">
      {steps.map((s) => (
        <div class="glass-panel rounded-2xl p-6 sm:p-8 border border-slate-800/80 flex flex-col sm:flex-row gap-5 items-start">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-purple-600 text-white font-mono font-bold text-lg flex items-center justify-center shrink-0 shadow-md shadow-blue-500/20">
            {s.num}
          </div>
          <div>
            <h3 class="text-lg font-bold text-white mb-2">{s.title}</h3>
            <p class="text-slate-300 text-sm leading-relaxed">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Folder Structure Reference -->
    <div class="glass-panel rounded-2xl p-6 border border-slate-800 font-mono text-xs text-slate-300 mb-16">
      <h3 class="font-bold text-sm text-white font-sans mb-2">SD Card Path Reference</h3>
      <pre class="bg-slate-950 p-4 rounded-xl border border-slate-800 text-blue-300 overflow-x-auto">
SDCARD/
├── ARCHIVE/
│   ├── ClockMu-1.0.0.muxapp      &lt;-- Drop your .muxapp files here
│   ├── JarMu-1.0.0.muxapp
│   ├── BatteryMu-1.0.0.muxapp
│   ├── SwapMu-1.0.0.muxapp
│   └── ScrapMu-0.2.0.muxapp
├── ROMS/
└── MUOS/</pre>
    </div>

    <!-- FAQ Section -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Frequently Asked Questions</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {faqs.map((f) => (
          <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
            <h4 class="font-bold text-sm text-white mb-2">{f.q}</h4>
            <p class="text-slate-400 text-xs leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</Layout>
