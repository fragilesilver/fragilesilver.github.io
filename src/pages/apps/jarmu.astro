---
import Layout from '../../layouts/Layout.astro';
import ControlsTable from '../../components/ControlsTable.astro';
import DeviceBadge from '../../components/DeviceBadge.astro';

const jarControls = [
  { button: 'Hold A', action: 'Build up shake power (watch the meter)' },
  { button: 'Release A', action: 'Tip the jar (hit sweet spot for a "perfect shake")' },
  { button: 'L1 / R1', action: 'Open Filters menu' },
  { button: 'Y', action: 'Toggle "Surprise Me" mode (ignores all filters)' },
  { button: 'X', action: 'Cycle theme color' },
  { button: 'SELECT', action: 'Toggle procedurally synthesized sound effects' },
  { button: 'B', action: 'Quit to muOS' },
];

const filterControls = [
  { button: 'D-pad Up/Down', action: 'Navigate within current filter column' },
  { button: 'L1 / R1', action: 'Switch column (Systems / Genre / Status)' },
  { button: 'A', action: 'Toggle item (or flip genre match mode any / all)' },
  { button: 'Y', action: 'Include all items in current column' },
  { button: 'B', action: 'Return back to jar' },
];

const resultControls = [
  { button: 'A / B', action: 'Reshake (return to the jar)' },
  { button: 'Y', action: '"Not feeling it" — skip game for this session' },
  { button: 'X', action: 'Cycle status (backlog → playing → beaten → favourite)' },
  { button: 'L1', action: 'Open in-app genre editor' },
];
---

<Layout
  title="JarMu • Random Game Picker for muOS Andromeda"
  description="Shake the jar random game selector for muOS Andromeda on Anbernic RG35XX with weighted physics, filters, and retro CRT aesthetics."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    
    <!-- Hero Header -->
    <div class="glass-panel rounded-3xl p-8 sm:p-10 border border-slate-800 mb-12 relative overflow-hidden">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="flex items-center gap-5">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-slate-900 border border-slate-700 p-2.5 flex items-center justify-center shadow-lg shadow-purple-500/10">
            <img src="/assets/icons/jarmu.png" alt="JarMu Logo" class="max-w-full max-h-full object-contain" />
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <h1 class="text-2xl sm:text-3xl font-bold text-white">JarMu</h1>
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/30">v1.0.0</span>
            </div>
            <p class="text-slate-400 text-sm">
              "Shake the jar" weighted random game picker for muOS
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="https://github.com/fragilesilver/JarMu/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-xl font-semibold text-xs text-white bg-purple-600 hover:bg-purple-500 transition-colors flex items-center gap-2 shadow-md shadow-purple-600/20"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Download .muxapp</span>
          </a>
          <a
            href="https://github.com/fragilesilver/JarMu"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-xl font-medium text-xs text-slate-300 bg-slate-800 hover:bg-slate-700 transition-colors flex items-center gap-2 border border-slate-700"
          >
            <span>GitHub</span>
            <span class="text-xs">↗</span>
          </a>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-wrap items-center gap-3">
        <DeviceBadge device="RG35XX Pro, Plus, H, SP, 2024" chipset="H700" />
        <span class="text-xs font-mono text-slate-400 px-3 py-1 rounded-full bg-slate-900 border border-slate-800">LÖVE2D 11.5</span>
        <span class="text-xs font-mono text-slate-400 px-3 py-1 rounded-full bg-slate-900 border border-slate-800">fskit v0.3</span>
      </div>
    </div>

    <!-- Screenshots -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-12">
      <div class="rounded-2xl overflow-hidden border border-slate-800 bg-slate-950 p-2 shadow-xl">
        <img
          src="https://github.com/user-attachments/assets/ca257d31-2f3d-4dc3-8ac3-a17939961d8a"
          alt="JarMu Splash Screen"
          class="w-full h-auto rounded-xl object-cover"
        />
        <p class="text-xs text-slate-400 text-center mt-2 font-mono">Arcade Splash Screen</p>
      </div>
      <div class="rounded-2xl overflow-hidden border border-slate-800 bg-slate-950 p-2 shadow-xl">
        <img
          src="https://github.com/user-attachments/assets/5f0d53ca-cf92-4fc7-9a57-c1a0640b4190"
          alt="JarMu Main Jar Screen"
          class="w-full h-auto rounded-xl object-cover"
        />
        <p class="text-xs text-slate-400 text-center mt-2 font-mono">The Jar & Shake Power Meter</p>
      </div>
    </div>

    <!-- Feature Grid -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
        Key Highlights
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <h3 class="text-white font-semibold text-sm mb-1.5">Dual SD Card & PortMaster Scan</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Scans both SD1 and SD2 (<code class="font-mono text-blue-300">ROMS/&lt;system&gt;/</code>) plus PortMaster ports (<code class="font-mono text-blue-300">ports/*.sh</code>). Bundles sample sets when empty.
          </p>
        </div>
        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <h3 class="text-white font-semibold text-sm mb-1.5">Weighted Shake Mechanics</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Backlog titles get ×3 weight, favourites ×2, playing ×1.5, beaten ×0.5. Perfect shake timing gives an extra weighting boost!
          </p>
        </div>
        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <h3 class="text-white font-semibold text-sm mb-1.5">In-App Genre Editor</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Edit and adjust game genres right on the result screen without modifying your read-only <code class="font-mono text-slate-300">gamelist.xml</code> files.
          </p>
        </div>
        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <h3 class="text-white font-semibold text-sm mb-1.5">Retro CRT Visuals & Audio</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Procedurally synthesized retro sound effects paired with CRT scanlines, neon chromatic aberration, and arcade aesthetic.
          </p>
        </div>
      </div>
    </div>

    <!-- Controls Tables -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
        Handheld Gamepad Controls
      </h2>
      <ControlsTable title="Jar Screen (Main)" controls={jarControls} />
      <ControlsTable title="Filters (Systems / Genre / Status)" controls={filterControls} />
      <ControlsTable title="Pick Result Screen" controls={resultControls} />
    </div>

    <!-- Technical Note -->
    <div class="glass-panel rounded-2xl p-6 border border-slate-800 text-xs text-slate-400 space-y-3">
      <h3 class="font-bold text-sm text-white">Non-Intrusive Design</h3>
      <p>
        JarMu is strictly a game selector: it decides <em>what</em> to play so you can launch it cleanly through muOS yourself. This prevents core mismatches and ensures 100% stability across every RG35XX screen revision.
      </p>
    </div>

  </div>
</Layout>
