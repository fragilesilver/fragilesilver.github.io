---
import Layout from '../../layouts/Layout.astro';
import ControlsTable from '../../components/ControlsTable.astro';
import DeviceBadge from '../../components/DeviceBadge.astro';

const coreControls = [
  { button: 'D-pad Up/Down', action: 'Navigate core list' },
  { button: 'L1 / R1', action: 'Page up / down' },
  { button: 'L2 / R2', action: 'Jump 100 entries' },
  { button: 'A', action: 'Open selected core games list' },
  { button: 'X', action: 'Open backup restore menu' },
  { button: 'Y', action: 'Change visual theme' },
  { button: 'SELECT', action: 'Inspect detected filesystem storage paths' },
  { button: 'B', action: 'Quit to muOS (prompts for confirmation)' },
];

const compareControls = [
  { button: 'L1', action: 'Copy RetroArch SRAM → Pickle' },
  { button: 'R1', action: 'Copy Pickle SRAM → RetroArch' },
  { button: 'B', action: 'Cancel / return to game list' },
];

const confirmControls = [
  { button: 'A', action: 'Confirm save transfer (hold A on high-risk tier)' },
  { button: 'B', action: 'Cancel transfer' },
];
---

<Layout
  title="SwapMu • SRAM Save Swapper for muOS Andromeda"
  description="Per-game SRAM save swapper bridging Pickle and RetroArch on muOS Andromeda with core bridging and 3-tier safe backup verification."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    
    <!-- Hero Header -->
    <div class="glass-panel rounded-3xl p-8 sm:p-10 border border-slate-800 mb-12 relative overflow-hidden">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="flex items-center gap-5">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-slate-900 border border-slate-700 p-2.5 flex items-center justify-center shadow-lg shadow-purple-500/10">
            <img src="/assets/icons/swapmu.svg" alt="SwapMu Logo" class="max-w-full max-h-full object-contain" />
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <h1 class="text-2xl sm:text-3xl font-bold text-white">SwapMu</h1>
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/30">v1.0.0</span>
            </div>
            <p class="text-slate-400 text-sm">
              SRAM save swapper between Pickle & RetroArch
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="https://github.com/fragilesilver/SwapMu/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-xl font-semibold text-xs text-white bg-purple-600 hover:bg-purple-500 transition-colors flex items-center gap-2 shadow-md shadow-purple-600/20"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Download .muxapp</span>
          </a>
          <a
            href="https://github.com/fragilesilver/SwapMu"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-xl font-medium text-xs text-slate-300 bg-slate-800 hover:bg-slate-700 transition-colors flex items-center gap-2 border border-slate-700"
          >
            <span>GitHub</span>
            <span class="text-xs">↗</span>
          </a>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-wrap items-center gap-3">
        <DeviceBadge device="RG35XX Pro, Plus, H, SP, 2024" chipset="H700" />
        <span class="text-xs font-mono text-purple-300 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/30">Andromeda 2606.0 Only</span>
        <span class="text-xs font-mono text-slate-400 px-3 py-1 rounded-full bg-slate-900 border border-slate-800">131 Unit Checks Passed</span>
      </div>
    </div>

    <!-- Feature Grid -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
        Core Capabilities
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <h3 class="text-white font-semibold text-sm mb-1.5">Pickle ↔ RetroArch Synchronization</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Bridges Pickle's embedded frontend libretro player and full RetroArch without loading ROMs or cores.
          </p>
        </div>
        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <h3 class="text-white font-semibold text-sm mb-1.5">Side-by-Side Save Comparison</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Inspect filesize, timestamps, and core versions before transferring, eliminating accidental save overwrites.
          </p>
        </div>
        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <h3 class="text-white font-semibold text-sm mb-1.5">3-Tier Safety Confirmation</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Clean copy, size mismatch warning, and hold-to-confirm protection for destination saves newer than the source.
          </p>
        </div>
        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <h3 class="text-white font-semibold text-sm mb-1.5">Automated Multi-Epoch Backups</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Automatically archives existing saves into <code class="font-mono text-purple-300">save/backup/</code> (keeping last 5) with full one-click restore.
          </p>
        </div>
      </div>
    </div>

    <!-- Controls -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
        Handheld Gamepad Controls
      </h2>
      <ControlsTable title="Cores List Screen" controls={coreControls} />
      <ControlsTable title="Save Comparison Screen" controls={compareControls} />
      <ControlsTable title="Confirmation Dialog" controls={confirmControls} />
    </div>

    <!-- Paths Handled -->
    <div class="glass-panel rounded-2xl p-6 border border-slate-800 text-xs text-slate-300 space-y-3 font-mono">
      <h3 class="font-bold text-sm text-white font-sans">Handled Save Paths</h3>
      <div class="p-3 rounded-lg bg-slate-950/80 border border-slate-800 text-slate-400 space-y-1">
        <div>Pickle:&nbsp;&nbsp;&nbsp;&nbsp;&lt;storage&gt;/save/pickles/sram/&lt;so&gt;/&lt;rom-subfolder&gt;/&lt;game&gt;.srm</div>
        <div>RetroArch:&nbsp;&lt;retroarch savefile_directory&gt;/&lt;CoreName&gt;/&lt;game&gt;.srm</div>
        <div>Backups:&nbsp;&nbsp;&nbsp;$SWAPMU_DATA/backup/&lt;side&gt;/&lt;so&gt;/&lt;game&gt;.srm.&lt;epoch&gt;</div>
      </div>
    </div>

  </div>
</Layout>
