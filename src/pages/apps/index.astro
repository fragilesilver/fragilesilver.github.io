---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import DeviceBadge from '../../components/DeviceBadge.astro';
import { projects } from '../../data/projects';

const muosApps = projects.filter((p) => p.category === 'muOS App');

const devices = [
  { name: 'RG35XX Pro', screen: '640×480 IPS', status: 'Primary Dev & Verified' },
  { name: 'RG35XX Plus', screen: '640×480 IPS', status: 'Fully Compatible' },
  { name: 'RG35XX H', screen: '640×480 IPS', status: 'Fully Compatible' },
  { name: 'RG35XX SP', screen: '640×480 IPS', status: 'Fully Compatible' },
  { name: 'RG35XX (2024)', screen: '640×480 IPS', status: 'Fully Compatible' },
];
---

<Layout
  title="muOS Apps • fragilesilver"
  description="Explore ClockMu, JarMu, BatteryMu, SwapMu, and ScrapMu for muOS Andromeda on Anbernic RG35XX devices."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    
    <!-- Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-blue-500/10 text-blue-400 border border-blue-500/30 mb-4">
        <span>Handheld Emulation Suite</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        Custom Apps for <span class="text-gradient">muOS Andromeda</span>
      </h1>
      <p class="text-slate-300 text-base leading-relaxed mb-6">
        A cohesive collection of 5 utilities designed specifically for muOS on the Anbernic Allwinner H700 handheld family. Built on LÖVE2D and the shared <strong>fskit</strong> toolkit with native gamepad controls, theme synchronization, and robust data persistence.
      </p>
      <div>
        <DeviceBadge device="Anbernic RG35XX Pro, Plus, H, SP, 2024" chipset="Allwinner H700" />
      </div>
    </div>

    <!-- App Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {muosApps.map((app) => (
        <ProjectCard
          title={app.title}
          category={app.category}
          version={app.version}
          description={app.description}
          icon={app.icon}
          href={app.href}
          githubUrl={app.githubUrl}
          tags={app.tags}
          featured={app.featured}
        />
      ))}
    </div>

    <!-- Supported Devices Table -->
    <div class="glass-panel rounded-3xl p-8 border border-slate-800 mb-16">
      <h2 class="text-xl font-bold text-white mb-2">Hardware Compatibility</h2>
      <p class="text-slate-400 text-sm mb-6">
        Every app is calibrated for Allwinner H700 Mali-G31 GPU with letterboxed 640×480 rendering and HDMI scaling.
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="text-xs uppercase text-slate-400 border-b border-slate-800">
            <tr>
              <th class="py-3 px-4 font-mono">Handheld Model</th>
              <th class="py-3 px-4 font-mono">Panel Resolution</th>
              <th class="py-3 px-4 font-mono">Support Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 font-mono text-xs">
            {devices.map((d) => (
              <tr class="hover:bg-slate-800/30 transition-colors">
                <td class="py-3 px-4 text-white font-medium">{d.name}</td>
                <td class="py-3 px-4 text-slate-400">{d.screen}</td>
                <td class="py-3 px-4 text-emerald-400 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  {d.status}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Call to install guide -->
    <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-900/30 to-purple-900/30 border border-blue-500/30 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h3 class="text-white font-bold text-base mb-1">Need help installing?</h3>
        <p class="text-slate-300 text-xs">
          Learn how to transfer .muxapp archives to your SD card and install via muOS Archive Manager.
        </p>
      </div>
      <a
        href="/guide/install"
        class="px-5 py-2.5 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white transition-colors whitespace-nowrap"
      >
        View Installation Guide →
      </a>
    </div>

  </div>
</Layout>
