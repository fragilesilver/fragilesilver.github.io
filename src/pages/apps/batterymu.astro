---
import Layout from '../../layouts/Layout.astro';
import ControlsTable from '../../components/ControlsTable.astro';
import DeviceBadge from '../../components/DeviceBadge.astro';

const mainControls = [
  { button: 'D-pad Up/Down', action: 'Scroll through battery metrics and charge logs' },
  { button: 'X', action: 'Cycle between 8 in-app theme colors' },
  { button: 'Y', action: 'Toggle extended voltage and health telemetry' },
  { button: 'B', action: 'Quit to muOS' },
];
---

<Layout
  title="BatteryMu • Live Battery Monitor for muOS Andromeda"
  description="Real-time battery monitor and health tracker for muOS Andromeda on Anbernic RG35XX devices with charging graphs and AXP2202 PMIC readouts."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    
    <!-- Hero Header -->
    <div class="glass-panel rounded-3xl p-8 sm:p-10 border border-slate-800 mb-12 relative overflow-hidden">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="flex items-center gap-5">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-slate-900 border border-slate-700 p-2.5 flex items-center justify-center shadow-lg shadow-blue-500/10">
            <img src="/assets/icons/batterymu-logo.png" alt="BatteryMu Logo" class="max-w-full max-h-full object-contain" />
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <h1 class="text-2xl sm:text-3xl font-bold text-white">BatteryMu</h1>
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/30">v1.0.0</span>
            </div>
            <p class="text-slate-400 text-sm">
              Live battery & health monitor for muOS Andromeda
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="https://github.com/fragilesilver/BatteryMu/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-xl font-semibold text-xs text-white bg-blue-600 hover:bg-blue-500 transition-colors flex items-center gap-2 shadow-md shadow-blue-600/20"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Download .muxapp</span>
          </a>
          <a
            href="https://github.com/fragilesilver/BatteryMu"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-xl font-medium text-xs text-slate-300 bg-slate-800 hover:bg-slate-700 transition-colors flex items-center gap-2 border border-slate-700"
          >
            <span>GitHub</span>
            <span class="text-xs">↗</span>
          </a>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-wrap items-center gap-3">
        <DeviceBadge device="RG35XX Pro, Plus, H, SP, 2024" chipset="H700" />
        <span class="text-xs font-mono text-slate-400 px-3 py-1 rounded-full bg-slate-900 border border-slate-800">LÖVE2D 11.5</span>
        <span class="text-xs font-mono text-slate-400 px-3 py-1 rounded-full bg-slate-900 border border-slate-800">AXP2202 PMIC</span>
      </div>
    </div>

    <!-- Feature Grid -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
        Telemetry Features
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <h3 class="text-white font-semibold text-sm mb-1.5">Live Charge & Voltage Gauge</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Real-time percentage readout, microvolt-accurate voltage tracking, and instant charge/discharge state detection.
          </p>
        </div>
        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <h3 class="text-white font-semibold text-sm mb-1.5">Cell Health Analysis</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Compares design voltage against current full-charge capacity to calculate actual battery health percentage over time.
          </p>
        </div>
        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <h3 class="text-white font-semibold text-sm mb-1.5">muOS Charge History Graph</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Visualizes discharge curves and session time directly from muOS's built-in <code class="font-mono text-blue-300">battery_usage</code> tracker.
          </p>
        </div>
        <div class="glass-panel rounded-2xl p-5 border border-slate-800/80">
          <h3 class="text-white font-semibold text-sm mb-1.5">AXP2202 Sysfs Fallback</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            Reads pre-parsed muOS battery status with automated fallback to the raw AXP2202 PMIC sysfs interface across all H700 handhelds.
          </p>
        </div>
      </div>
    </div>

    <!-- Controls -->
    <div class="mb-12">
      <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
        Handheld Gamepad Controls
      </h2>
      <ControlsTable title="Monitor Controls" controls={mainControls} />
    </div>

    <!-- Hardware PMIC architecture note -->
    <div class="glass-panel rounded-2xl p-6 border border-slate-800 text-xs text-slate-400 space-y-3">
      <h3 class="font-bold text-sm text-white">Universal H700 Sensor Implementation</h3>
      <p>
        Because all members of the Anbernic H700 family (RG35XX Pro, Plus, H, SP, and 2024) utilize the identical X-Powers AXP2202 Power Management IC, BatteryMu delivers consistent, calibrated telemetry regardless of which device or screen revision you play on.
      </p>
    </div>

  </div>
</Layout>
